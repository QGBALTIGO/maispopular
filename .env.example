# Crie o bot no @BotFather. Nunca publique o token.
BOT_TOKEN=COLE_O_TOKEN_DO_BOTFATHER

# Copie sua chave no painel de conta/API da SouPopular.
SOUPOPULAR_API_KEY=COLE_SUA_CHAVE_DA_SOPOPULAR

# IDs NUMÉRICOS autorizados, separados por vírgula.
# Vazio = ninguém tem acesso ao painel; /start e /meuid continuam disponíveis.
# Rode o bot, envie /meuid, copie o número para cá e reinicie.
ADMIN_IDS=

BOT_NAME=Mais Popular

# Padrão seguro: consulta catálogo/saldo reais, mas NÃO envia operações de escrita.
# Só mude para false depois de revisar a configuração e o fluxo.
DRY_RUN=true

# Teto do CUSTO ESTIMADO por pedido, NA MOEDA RETORNADA PELA API.
# Ex.: 20 BRL quando a API retornar BRL; 20 USD quando retornar USD.
# A API não oferece um parâmetro público de preço máximo no pedido.
MAX_ORDER_COST=20.00

# Vazio = todos os serviços retornados. Recomendado limitar aos IDs homologados.
# Exemplo de formato (não representa serviços recomendados): 123,456
ALLOWED_SERVICE_IDS=

# Consulta de status dos pedidos reais. Mínimo: 30 segundos.
POLL_SECONDS=120
DATABASE_PATH=data/bot.sqlite3
