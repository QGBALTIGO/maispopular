[Unit]
Description=Mais Popular - Bot Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maispopular
Group=maispopular
WorkingDirectory=/opt/maispopular
ExecStart=/opt/maispopular/.venv/bin/python /opt/maispopular/bot.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maispopular/data
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
