[Unit]
Description=Mais Popular - Mini App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maispopular
Group=maispopular
WorkingDirectory=/opt/maispopular
ExecStart=/opt/maispopular/.venv/bin/uvicorn webapp:default_app --factory --host 127.0.0.1 --port 8031 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maispopular/data
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
